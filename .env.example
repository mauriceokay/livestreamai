# ── Persona ────────────────────────────────────────────────────────────────────
PERSONA_NAME=Maya
APP_NAME=MyApp
APP_DESCRIPTION=a new chat app that makes it easy to connect with friends and meet new people

# ── TikTok LIVE ────────────────────────────────────────────────────────────────
# Chat reading — account needs 1,000+ followers to go LIVE
TIKTOK_USERNAME=your_tiktok_username
# Stream key from: TikTok LIVE Studio → Go Live → Stream key
TIKTOK_STREAM_KEY=your_tiktok_stream_key
# TIKTOK_RTMP_URL=rtmps://live-push.tiktok.com/live/   ← default, no need to set

# ── YouTube Live ───────────────────────────────────────────────────────────────
# Stream key from: YouTube Studio → Go Live → Stream key
# YOUTUBE_STREAM_KEY=your_youtube_stream_key
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2/    ← default

# ── Facebook Live ──────────────────────────────────────────────────────────────
# Stream key from: Facebook → Live Video → Use stream key
# FACEBOOK_STREAM_KEY=your_facebook_stream_key
# FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp/   ← default

# ── Instagram Live ─────────────────────────────────────────────────────────────
# Instagram uses the same Live API as Facebook.
# Stream key from: Instagram → Professional dashboard → Go Live via encoder
# INSTAGRAM_STREAM_KEY=your_instagram_stream_key
# INSTAGRAM_RTMP_URL=rtmps://edgetee-upload-lax5-1.instagram.com:443/rtmp/

# Set any combination above — all enabled destinations stream simultaneously.

# ── Overlays ───────────────────────────────────────────────────────────────────
# Required by TikTok / Meta ToS — do not disable on those platforms
SHOW_DISCLOSURE=true
DISCLOSURE_TEXT=AI Generated
# PROMO_TEXT=Download MyApp — link in bio!   ← auto-set from APP_NAME if empty

# ── LLM backend: "claude" (fast, cloud) or "ollama" (free, local) ─────────────
LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (no API key needed — runs locally at localhost:11434):
# LLM_BACKEND=ollama

# ── TTS backend ────────────────────────────────────────────────────────────────
TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Replace with your cloned voice ID

# Local TTS (no key needed):
# TTS_BACKEND=kokoro
# TTS_BACKEND=coqui

# XTTS2 local voice clone — fully owned, no API key, runs on GPU
# Step 1: record yourself (30+ min), run finetune/prepare_voice_data.py
# Step 2: fine-tune with finetune/train_voice.py (~2-4h on RTX 4090)
# Step 3: test with finetune/test_voice.py --model models/xtts_finetuned
# Step 4: enable below
# TTS_BACKEND=xtts_local
# XTTS_CHECKPOINT_DIR=models/xtts_finetuned   # leave empty for zero-shot (no fine-tune)
# XTTS_REFERENCE_WAV=models/xtts_finetuned/reference.wav
# XTTS_USE_GPU=true

# ── Lip-sync (used by generate_loops.py only — not the live stream) ───────────
# hallo2 / emo  = diffusion models, most realistic (natural blinks, head sway)
#                 requires A100 or RTX 4090; takes ~2-5 min per clip offline
# latsync       = fast & good, recommended if on RTX 3080+
# wav2lip       = CPU-compatible fallback
LIPSYNC_MODEL=latsync
LIPSYNC_DEVICE=cuda     # "cpu" if no GPU
