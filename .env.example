# ── Platform: "tiktok" or "youtube" ───────────────────────────────────────────
PLATFORM=tiktok

# ── TikTok ────────────────────────────────────────────────────────────────────
# Your TikTok username (needed for reading chat — account needs 1000+ followers to go LIVE)
TIKTOK_USERNAME=your_tiktok_username

# From TikTok LIVE Studio → Go Live → Copy Stream Key
RTMP_URL=rtmps://live-push.tiktok.com/live/
STREAM_KEY=your_tiktok_stream_key

# ── YouTube (use instead of TikTok above) ─────────────────────────────────────
# PLATFORM=youtube
# RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# STREAM_KEY=your_youtube_stream_key   # YouTube Studio → Go Live → Stream key

# ── Persona ────────────────────────────────────────────────────────────────────
PERSONA_NAME=Maya
APP_NAME=MyApp
APP_DESCRIPTION=a new chat app that makes it easy to connect with friends and meet new people

# ── Stream overlays ────────────────────────────────────────────────────────────
# Required by TikTok ToS — do not disable on TikTok
SHOW_DISCLOSURE=true
DISCLOSURE_TEXT=AI Generated

# Lower-third banner (auto-set from APP_NAME if not specified)
# PROMO_TEXT=Download MyApp — link in bio!

# ── LLM backend: "claude" (fast, cloud) or "ollama" (free, local) ─────────────
LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# If using Ollama locally:
# LLM_BACKEND=ollama
# (Ollama runs at localhost:11434 — no key needed)

# ── TTS backend: "elevenlabs" (best), "kokoro" (local), "coqui" (local) ───────
TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Replace with your cloned voice ID

# ── Lip-sync (only used by generate_loops.py, not the live stream) ─────────────
LIPSYNC_MODEL=latsync   # "latsync" (GPU, best) or "wav2lip" (CPU, good)
LIPSYNC_DEVICE=cuda     # "cpu" if no GPU
