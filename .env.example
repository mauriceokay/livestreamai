# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_USERNAME=your_tiktok_username

# TikTok LIVE Studio → Stream → Stream key & server URL
RTMP_URL=rtmps://live-push.tiktok.com/live/
STREAM_KEY=your_stream_key_here

# ── Persona ────────────────────────────────────────────────────────────────────
PERSONA_NAME=Maya
APP_NAME=MyApp
APP_DESCRIPTION=a new chat app that makes it easy to connect with friends and meet new people

# ── LLM backend: "claude" or "ollama" ─────────────────────────────────────────
LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# If using Ollama locally instead:
# LLM_BACKEND=ollama
# (no API key needed — Ollama runs on localhost:11434)

# ── TTS backend: "elevenlabs", "kokoro", or "coqui" ───────────────────────────
TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Replace with your cloned voice ID

# ── Lip sync: "latsync" (needs GPU) or "wav2lip" (CPU ok) ─────────────────────
LIPSYNC_MODEL=latsync
LIPSYNC_DEVICE=cuda   # "cpu" if no GPU
